# =============================================================================
# Web BFF - Local Development Environment (without Dapr)
# =============================================================================
# Copy this file to .env when running WITHOUT Dapr sidecar
# Usage: Copy-Item .env.local .env (Windows) or cp .env.local .env (Linux/Mac)
# =============================================================================

# Server Configuration
NODE_ENV=development
PORT=8014
HOST=0.0.0.0
NAME=web-bff
VERSION=1.0.0

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:9999

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=console
LOG_TO_CONSOLE=true
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/web-bff.log

# =============================================================================
# Direct Service URLs (for non-Dapr mode)
# =============================================================================
# In non-Dapr mode, the BFF calls backend services directly via HTTP
# These URLs are used when Dapr sidecar is not available

AUTH_SERVICE_URL=http://localhost:8004
USER_SERVICE_URL=http://localhost:8002
PRODUCT_SERVICE_URL=http://localhost:8001
INVENTORY_SERVICE_URL=http://localhost:8005
CART_SERVICE_URL=http://localhost:8008
ORDER_SERVICE_URL=http://localhost:8006
REVIEW_SERVICE_URL=http://localhost:8010
ADMIN_SERVICE_URL=http://localhost:8003
CHAT_SERVICE_URL=http://localhost:8013

# =============================================================================
# Service Tokens (for service-to-service authentication)
# =============================================================================
AUTH_SERVICE_TOKEN=svc-auth-service-4ff5876fc86cc45a18d88e5d
USER_SERVICE_TOKEN=svc-user-service-4ff5876fc86cc45a18d88e5d
PRODUCT_SERVICE_TOKEN=svc-product-service-4ff5876fc86cc45a18d88e5d
INVENTORY_SERVICE_TOKEN=svc-inventory-service-4ff5876fc86cc45a18d88e5d
CART_SERVICE_TOKEN=svc-cart-service-4ff5876fc86cc45a18d88e5d
ORDER_SERVICE_TOKEN=svc-order-service-4ff5876fc86cc45a18d88e5d
REVIEW_SERVICE_TOKEN=svc-review-service-4ff5876fc86cc45a18d88e5d
ADMIN_SERVICE_TOKEN=svc-admin-service-4ff5876fc86cc45a18d88e5d
