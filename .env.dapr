# Service Configuration
SERVICE_NAME=web-bff
VERSION=1.0.0
PORT=8014
HOST=0.0.0.0
NODE_ENV=development

# Logging
LOG_LEVEL=debug
LOG_FILE_PATH=logs/web-bff.log

# Service Invocation Mode
SERVICE_INVOCATION_MODE=dapr

# Messaging Provider (for pub/sub events)
MESSAGING_PROVIDER=dapr-pubsub

# Dapr Configuration
DAPR_HOST=localhost
DAPR_HTTP_PORT=3514
DAPR_GRPC_PORT=50014
DAPR_APP_ID=web-bff

# JWT Configuration
JWT_SECRET=8tDBDMcpxroHoHjXjk8xp/uAn8rzD4y8ZZremFkC4gI=
JWT_ISSUER=auth-service
JWT_AUDIENCE=xshopai-platform

# Service App IDs (for Dapr service invocation)
AUTH_SERVICE_APP_ID=auth-service
USER_SERVICE_APP_ID=user-service
PRODUCT_SERVICE_APP_ID=product-service
INVENTORY_SERVICE_APP_ID=inventory-service
CART_SERVICE_APP_ID=cart-service
ORDER_SERVICE_APP_ID=order-service
REVIEW_SERVICE_APP_ID=review-service
ADMIN_SERVICE_APP_ID=admin-service
CHAT_SERVICE_APP_ID=chat-service
PAYMENT_SERVICE_APP_ID=payment-service

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3010

# =============================================================================
# OpenTelemetry Tracing Configuration
# =============================================================================

# Option 1: Zipkin (Local Development)
OTEL_TRACES_EXPORTER=zipkin
OTEL_EXPORTER_ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

# Option 2: OTLP (OpenTelemetry Collector)
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service name for tracing
OTEL_SERVICE_NAME=web-bff
