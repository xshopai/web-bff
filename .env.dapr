# =============================================================================
# Web BFF - Dapr Development Environment
# =============================================================================
# Copy this file to .env when running WITH Dapr sidecar
# Usage: Copy-Item .env.dapr .env (Windows) or cp .env.dapr .env (Linux/Mac)
# =============================================================================

# Server Configuration
NODE_ENV=development
PORT=8014
HOST=0.0.0.0
SERVICE_NAME=web-bff
VERSION=1.0.0

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:9999

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=console
LOG_TO_CONSOLE=true
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/web-bff.log

# =============================================================================
# Dapr Configuration
# =============================================================================
DAPR_HOST=localhost
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001
DAPR_APP_ID=web-bff

# =============================================================================
# Service App IDs (for Dapr service invocation)
# =============================================================================
# These are the Dapr app-ids of backend services
# Dapr uses these to route service-to-service calls

AUTH_SERVICE_APP_ID=auth-service
USER_SERVICE_APP_ID=user-service
PRODUCT_SERVICE_APP_ID=product-service
INVENTORY_SERVICE_APP_ID=inventory-service
CART_SERVICE_APP_ID=cart-service
ORDER_SERVICE_APP_ID=order-service
REVIEW_SERVICE_APP_ID=review-service
ADMIN_SERVICE_APP_ID=admin-service
CHAT_SERVICE_APP_ID=chat-service

# =============================================================================
# Service Tokens (for service-to-service authentication)
# =============================================================================
AUTH_SERVICE_TOKEN=svc-auth-service-4ff5876fc86cc45a18d88e5d
USER_SERVICE_TOKEN=svc-user-service-4ff5876fc86cc45a18d88e5d
PRODUCT_SERVICE_TOKEN=svc-product-service-4ff5876fc86cc45a18d88e5d
INVENTORY_SERVICE_TOKEN=svc-inventory-service-4ff5876fc86cc45a18d88e5d
CART_SERVICE_TOKEN=svc-cart-service-4ff5876fc86cc45a18d88e5d
ORDER_SERVICE_TOKEN=svc-order-service-4ff5876fc86cc45a18d88e5d
REVIEW_SERVICE_TOKEN=svc-review-service-4ff5876fc86cc45a18d88e5d
ADMIN_SERVICE_TOKEN=svc-admin-service-4ff5876fc86cc45a18d88e5d

# =============================================================================
# Application Insights (Azure Monitor)
# =============================================================================
# Get connection string from Azure Portal > Application Insights > Overview
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxx;IngestionEndpoint=https://xxx.in.applicationinsights.azure.com/
