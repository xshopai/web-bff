# Service Configuration
SERVICE_NAME=web-bff
VERSION=1.0.0
PORT=8014
HOST=0.0.0.0
NODE_ENV=development

# Logging
LOG_LEVEL=debug
LOG_FILE_PATH=logs/web-bff.log

# Service Invocation Mode
SERVICE_INVOCATION_MODE=dapr

# Messaging Provider (for pub/sub events)
MESSAGING_PROVIDER=dapr

# Dapr sidecar ports (only used in dapr mode)
DAPR_HOST=localhost
DAPR_HTTP_PORT=3514
DAPR_GRPC_PORT=50014
DAPR_APP_ID=web-bff

# JWT Configuration
JWT_SECRET=8tDBDMcpxroHoHjXjk8xp/uAn8rzD4y8ZZremFkC4gI=
JWT_ISSUER=auth-service
JWT_AUDIENCE=xshopai-platform

# Direct Service URLs (HTTP fallback) and App IDs (Dapr invocation)
AUTH_SERVICE_URL=http://localhost:8004
USER_SERVICE_URL=http://localhost:8002
PRODUCT_SERVICE_URL=http://localhost:8001
INVENTORY_SERVICE_URL=http://localhost:8005
CART_SERVICE_URL=http://localhost:8008
ORDER_SERVICE_URL=http://localhost:8006
REVIEW_SERVICE_URL=http://localhost:8010
ADMIN_SERVICE_URL=http://localhost:8003
CHAT_SERVICE_URL=http://localhost:8013
PAYMENT_SERVICE_URL=http://localhost:8009
AUTH_SERVICE_APP_ID=auth-service
USER_SERVICE_APP_ID=user-service
PRODUCT_SERVICE_APP_ID=product-service
INVENTORY_SERVICE_APP_ID=inventory-service
CART_SERVICE_APP_ID=cart-service
ORDER_SERVICE_APP_ID=order-service
REVIEW_SERVICE_APP_ID=review-service
ADMIN_SERVICE_APP_ID=admin-service
CHAT_SERVICE_APP_ID=chat-service
PAYMENT_SERVICE_APP_ID=payment-service

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3010

# =============================================================================
# OpenTelemetry Tracing Configuration
# =============================================================================
# Option 1: Zipkin (Local Development)
OTEL_TRACES_EXPORTER=zipkin
OTEL_EXPORTER_ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

# Option 2: OTLP (OpenTelemetry Collector)
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Option 3: Azure Application Insights
# OTEL_TRACES_EXPORTER=azure
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxx;IngestionEndpoint=https://xxx.applicationinsights.azure.com/

OTEL_SERVICE_NAME=web-bff
